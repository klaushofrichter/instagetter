# ---------------------------------------------------------------------------
# instagetter configuration. Copy to .env and fill in.
# .env is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# Comma-separated bearer tokens accepted by the protected /api/* endpoints.
# Generate one with: openssl rand -hex 32
# Rotate by adding the new token, deploying, then removing the old one.
INSTA_API_TOKENS=generate-with-openssl-rand-hex-32

# --- S3: where extracted images live -------------------------------------
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Credentials for a user scoped to that single bucket. In the cluster these
# come from a Kubernetes Secret via envFrom. Locally you can leave these blank
# and point the AWS SDK at a shared credentials file instead:
#   export AWS_SHARED_CREDENTIALS_FILE=$HOME/path/to/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional tuning (defaults shown) -------------------------------------
# CACHE_DIR=/tmp/instagetter-cache   # local image cache directory
# CACHE_LIMIT=99                     # images cached locally, newest by post date
# REFRESH_MIN_INTERVAL_MS=5000       # server-enforced gap between refreshes
# BROWSE_RATE_LIMIT=600              # page/image requests per minute per IP
# S3_KEEP=999                        # slots retained in S3 by the upload script
# PORT=8080

# --- Deployment only -------------------------------------------------------
# GitHub PAT used by the deploy workflow to push a manifest update to the
# cluster repo. Stored as a GitHub repository secret; not read at runtime.
KUBE_SETUP_DEPLOY_TOKEN=
