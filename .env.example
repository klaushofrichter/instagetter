# Comma-separated bearer tokens accepted by the protected /api/* endpoints.
# Generate with: openssl rand -hex 32
INSTA_API_TOKENS=generate-with-openssl-rand-hex-32

# GitHub PAT (repo scope) used by the deploy workflow to push the updated
# image tag to the kube-setup repo. Stored in GitHub as a repository secret,
# not read by the service at runtime.
KUBE_SETUP_DEPLOY_TOKEN=
