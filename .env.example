# Comma-separated bearer tokens for the protected /api/status endpoint.
# Generate with: openssl rand -hex 32
INSTA_API_TOKENS=generate-with-openssl-rand-hex-32

# S3 — where extracted images live. Non-secret.
S3_BUCKET=klaushofrichter-k3s-insta-images
AWS_REGION=us-east-1

# Access keys. In the cluster these come from the insta-secrets Secret.
# Locally, prefer pointing the SDK at the shared credentials file instead of
# copying keys here:
#   export AWS_SHARED_CREDENTIALS_FILE=$HOME/Development/kubesetup/credentials-insta
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional tuning
# CACHE_DIR=/tmp/instagetter-cache   # where the local image cache is written
# CACHE_LIMIT=99                     # images cached locally, newest by post date
# REFRESH_MIN_INTERVAL_MS=5000       # server-enforced gap between refreshes
# BROWSE_RATE_LIMIT=600              # page/image requests per minute per IP
# S3_KEEP=999                        # slots retained in S3 by the upload script

# GitHub PAT for the deploy workflow (repository secret, not read at runtime).
KUBE_SETUP_DEPLOY_TOKEN=
