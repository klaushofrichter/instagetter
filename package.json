{
  "name": "instagetter",
  "private": true,
  "description": "Gallery service for insta.klaushofrichter.net: serves Instagram images extracted to S3.",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "upload": "node scripts/upload-to-s3.js",
    "known-ids": "node scripts/known-ids.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "sharp": "^0.35.3",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
